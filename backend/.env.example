DATABASE_URL=postgresql://user:password@host:5432/database
ACCESS_TOKEN_SECRET=replace-me
REFRESH_TOKEN_SECRET=replace-me

# AI automation. Keep GROQ_API_KEY server-side only.
AI_AUTOMATION_ENABLED=false
GROQ_API_KEY=gsk_replace_me
GROQ_COMMAND_MODEL=openai/gpt-oss-20b
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
AI_MAX_AUDIO_BYTES=10485760
AI_COMMAND_RETENTION_DAYS=30
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_COMMANDS_PER_DAY=100
