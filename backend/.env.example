DATABASE_URL=postgresql://user:password@host:5432/database
ACCESS_TOKEN_SECRET=replace-me
REFRESH_TOKEN_SECRET=replace-me

# AI automation. Keep all provider API keys server-side only.
AI_AUTOMATION_ENABLED=false

# Command parsing: any OpenAI-compatible Chat Completions provider.
AI_COMMAND_PROVIDER=groq
AI_COMMAND_BASE_URL=https://api.groq.com/openai/v1
AI_COMMAND_PATH=/chat/completions
AI_COMMAND_API_KEY=gsk_replace_me
AI_COMMAND_MODEL=openai/gpt-oss-20b
# auto selects json_object for DeepSeek and json_schema for other providers.
# Use text when a provider supports neither response format.
AI_COMMAND_RESPONSE_FORMAT=auto

# Speech-to-text: any OpenAI-compatible audio transcription provider.
AI_SPEECH_PROVIDER=groq
AI_SPEECH_BASE_URL=https://api.groq.com/openai/v1
AI_SPEECH_PATH=/audio/transcriptions
AI_SPEECH_API_KEY=gsk_replace_me
AI_SPEECH_MODEL=whisper-large-v3-turbo
AI_SPEECH_RESPONSE_FORMAT=json
AI_SPEECH_TEMPERATURE=0
AI_SPEECH_SEND_LANGUAGE=true
AI_SPEECH_SEND_PROMPT=true
# Optional override; leave empty to use the built-in Bangla/English/Banglish prompt.
AI_SPEECH_PROMPT=
# Used only by npm run benchmark:stt; comma-separated models.
AI_SPEECH_BENCHMARK_MODELS=whisper-large-v3,whisper-large-v3-turbo

# Legacy fallbacks: GROQ_API_KEY, GROQ_COMMAND_MODEL, GROQ_SPEECH_MODEL.
AI_MAX_AUDIO_BYTES=10485760
AI_COMMAND_RETENTION_DAYS=30
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_COMMANDS_PER_DAY=100
