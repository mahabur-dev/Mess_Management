{
  "name": "mess-management-backend",
  "version": "1.0.0",
  "description": "Mess Management System Backend - NestJS + Prisma + NeonDB",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "test:expense": "npm run build && node --test test/expense-calculator.test.js test/expense-approval-policy.test.js test/fund-balance-calculator.test.js test/billing-month-sequence.test.js",
    "test:payment": "npm run build && node --test test/payment-approval-policy.test.js",
    "test:meal": "npm run build && node --test test/meal-policy.test.js",
    "test:ai": "npm run build && node --test test/ai-command-normaliser.test.js",
    "test:billing": "npm run build && node --test test/billing-calculator.test.js test/billing-period.test.js test/billing-month-sequence.test.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node scripts/start-nest.js start",
    "start:dev": "node scripts/start-nest.js start --watch",
    "start:debug": "node scripts/start-nest.js start --debug --watch",
    "start:prod": "node scripts/start-built.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push"
  },
