model AiCommand {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id          String              @db.Uuid
  user_id          String              @db.Uuid
  source_type      AiCommandSourceType
  intent           AiCommandIntent
  status           AiCommandStatus     @default(PENDING)
  locale           String              @default("en") @db.VarChar(10)
  original_input   String?             @db.Text
  transcript       String?             @db.Text
  normalized_text  String              @db.Text
  provider         String              @db.VarChar(40)
  stt_model        String?             @db.VarChar(80)
  command_model    String              @db.VarChar(80)
  parsed_payload   Json                @db.JsonB
  resolved_payload Json?               @db.JsonB
  result_payload   Json?               @db.JsonB
  missing_fields   Json?               @db.JsonB
  clarification    String?             @db.Text
  confidence       Decimal?            @db.Decimal(5, 4)
  idempotency_key  String              @unique @db.VarChar(100)
  error_code       String?             @db.VarChar(80)
  error_message    String?             @db.Text
  confirmed_at     DateTime?           @db.Timestamptz
  created_at       DateTime            @default(now()) @db.Timestamptz
  updated_at       DateTime            @updatedAt @db.Timestamptz

  mess Mess @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([mess_id, created_at])
  @@index([user_id, status, created_at])
  @@map("ai_commands")
}
