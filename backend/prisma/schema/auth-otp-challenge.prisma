// Short-lived, single-purpose OTP state. OTP values and reset tokens are
// stored as keyed hashes so a database read cannot reveal usable credentials.
model AuthOtpChallenge {
  id                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String         @db.Uuid
  purpose                 AuthOtpPurpose
  otp_hash                String         @db.VarChar(64)
  expires_at              DateTime       @db.Timestamptz
  resend_available_at     DateTime       @db.Timestamptz
  failed_attempts         Int            @default(0)
  verified_at             DateTime?      @db.Timestamptz
  verification_token_hash String?        @db.VarChar(64)
  verification_token_expiry DateTime?    @db.Timestamptz
  created_at              DateTime       @default(now()) @db.Timestamptz
  updated_at              DateTime       @updatedAt @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, purpose])
  @@index([expires_at])
  @@map("auth_otp_challenges")
}
