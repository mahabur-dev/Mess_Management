// prisma/schema/bazar.prisma
// ────────────────────────────────────────────
// Bazar table
// ────────────────────────────────────────────

model Bazar {
  id         String      @id @default(cuid())
  messId     String
  userId     String
  name       String
  date       DateTime    @default(now())
  totalPrice Decimal     @db.Decimal(10, 2)
  items      BazarItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  mess  Mess @relation(fields: [messId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("bazars")
}

// Embedded bazar items stored as separate rows (normalized)
model BazarItem {
  id       String  @id @default(cuid())
  bazarId  String
  itemName String
  price    Decimal @db.Decimal(10, 2)

  bazar Bazar @relation(fields: [bazarId], references: [id], onDelete: Cascade)

  @@map("bazar_items")
}
