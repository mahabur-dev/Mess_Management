// ============================================================
// prisma/schema/deposit.prisma
// Table: deposits
// ============================================================

model Deposit {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id      String        @db.Uuid
  member_id    String        @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  note         String?       @db.Text
  confirmed_by String?       @db.Uuid
  confirmed_at DateTime?     @db.Timestamptz
  created_at   DateTime      @default(now()) @db.Timestamptz

  // ─── Relations ─────────────────────────────────────────
  mess      Mess  @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  member    User  @relation("DepositMember", fields: [member_id], references: [id])
  confirmer User? @relation("DepositConfirmer", fields: [confirmed_by], references: [id])

  @@index([mess_id, member_id])
  @@map("deposits")
}

enum DepositLedgerType {
  MEMBER_DEPOSIT
  PERSONAL_EXPENSE_CREDIT
  MESS_EXPENSE_DEBIT
  COLLECTED_FUND_IN
  COLLECTED_FUND_OUT
  ADJUSTMENT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

model DepositLedger {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id    String            @db.Uuid
  member_id  String?           @db.Uuid
  expense_id String?           @db.Uuid
  type       DepositLedgerType
  direction  LedgerDirection
  amount     Decimal           @db.Decimal(12, 2)
  note       String?           @db.Text
  created_at DateTime          @default(now()) @db.Timestamptz

  mess    Mess     @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  member  User?    @relation("DepositLedgerMember", fields: [member_id], references: [id])
  expense Expense? @relation(fields: [expense_id], references: [id], onDelete: SetNull)

  @@index([mess_id, created_at])
  @@index([mess_id, member_id])
  @@index([expense_id])
  @@map("deposit_ledgers")
}
