// ============================================================
// prisma/schema/expense.prisma
// Table: expenses
// ============================================================

model Expense {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id      String          @db.Uuid
  category     ExpenseCategory
  amount       Decimal         @db.Decimal(12, 2)
  description  String?         @db.Text
  receipt_url  String?         @db.Text
  created_by   String          @db.Uuid
  expense_date DateTime        @db.Date
  created_at   DateTime        @default(now()) @db.Timestamptz

  // ─── Relations ─────────────────────────────────────────
  mess    Mess @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  creator User @relation("ExpenseCreator", fields: [created_by], references: [id])

  @@index([mess_id, expense_date])
  @@map("expenses")
}
