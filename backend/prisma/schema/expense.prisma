// ============================================================
// prisma/schema/expense.prisma
// Table: expenses
// ============================================================

enum ExpensePaymentType {
  FROM_DEPOSIT
  PERSONAL
  COLLECTED_FUND
}

enum ExpenseRecordType {
  EXPENSE
  UTILITY
}

enum ExpenseUsedBy {
  SELF_ONLY
  SELECTED_MEMBERS
  ALL_MEMBERS
  MEAL_ON_MEMBERS
}

enum ExpenseSplitMethod {
  EQUAL
  MEAL_COUNT
  CUSTOM
}

enum ExpenseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum UtilityType {
  ELECTRICITY
  GAS
  WATER
  WIFI
  CLEANING
  OTHER
}

model Expense {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id      String             @db.Uuid
  type         ExpenseRecordType  @default(EXPENSE)
  category     ExpenseCategory
  utility_type UtilityType?
  amount       Decimal            @db.Decimal(12, 2)
  description  String?            @db.Text
  receipt_url  String?            @db.Text
  receipt_public_id String?        @db.Text
  receipt_resource_type String?    @db.VarChar(20)
  buyer_id     String?            @db.Uuid
  purchased_by String?            @db.Uuid
  item_name    String?            @db.VarChar(150)
  quantity     Decimal?           @db.Decimal(10, 3)
  unit         String?            @db.VarChar(30)
  created_by   String             @db.Uuid
  expense_date DateTime           @db.Date
  billing_month DateTime?         @db.Date
  payment_type ExpensePaymentType @default(FROM_DEPOSIT)
  used_by      ExpenseUsedBy      @default(ALL_MEMBERS)
  split_method ExpenseSplitMethod @default(MEAL_COUNT)
  status       ExpenseStatus      @default(CONFIRMED)
  reviewed_by  String?            @db.Uuid
  reviewed_at  DateTime?          @db.Timestamptz
  review_note  String?            @db.VarChar(500)
  created_at   DateTime           @default(now()) @db.Timestamptz
  updated_at   DateTime           @updatedAt @db.Timestamptz

  // Relations
  mess      Mess @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  creator   User @relation("ExpenseCreator", fields: [created_by], references: [id])
  purchaser User? @relation("ExpensePurchaser", fields: [purchased_by], references: [id])
  shares    ExpenseShare[]
  ledger_entries DepositLedger[]

  @@index([mess_id, expense_date])
  @@index([mess_id, billing_month])
  @@index([mess_id, type, status])
  @@map("expenses")
}

model ExpenseShare {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expense_id   String   @db.Uuid
  member_id    String   @db.Uuid
  member_name  String?  @db.VarChar(100)
  meal_count   Decimal? @db.Decimal(12, 2)
  share_amount Decimal  @db.Decimal(12, 2)
  is_payer     Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz

  expense Expense @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  member  User    @relation("ExpenseShareMember", fields: [member_id], references: [id])

  @@unique([expense_id, member_id])
  @@index([member_id])
  @@map("expense_shares")
}
