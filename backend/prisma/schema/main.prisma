// ============================================================
// prisma/schema/main.prisma
// Generator · Datasource · All Enums
// Prisma 7.x — prismaSchemaFolder is stable, no previewFeatures needed
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ──────────────────────────────────────────────────
enum GlobalRole {
  ADMIN
  MANAGER
  MEMBER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── MessMembership ────────────────────────────────────────
enum MembershipRole {
  MANAGER
  MEMBER
}

// ─── Meal ──────────────────────────────────────────────────
enum MealName {
  BREAKFAST
  LUNCH
  DINNER
}

enum MealStatus {
  PENDING
  CONFIRMED
  CANCELLED
  LOCKED
}

// ─── MealAttendance ────────────────────────────────────────
enum AttendanceStatus {
  ON
  OFF
}

enum MealAttendanceSource {
  MANUAL
  PATTERN
}

enum MealPatternType {
  DAILY
  WEEKLY
}

enum MealPatternStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

// ─── Expense ───────────────────────────────────────────────
enum ExpenseCategory {
  GROCERY
  UTILITY
  RENT
  FOOD
  GAS
  ELECTRICITY
  WIFI
  CLEANER
  MAINTENANCE
  BUABILL
  WATER
  OTHER
}

// ─── Deposit ───────────────────────────────────────────────
enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  BANK
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── MonthlyBill ───────────────────────────────────────────
enum BillStatus {
  PENDING
  PAID
  PARTIAL
}

enum BillingCalculationStatus {
  DIRTY
  PROCESSING
  READY
  FAILED
}

// ─── ShoppingList ──────────────────────────────────────────
enum ShoppingListStatus {
  OPEN
  PURCHASED
  CANCELLED
}

// ─── Notification ──────────────────────────────────────────
enum NotificationType {
  MEAL_UPDATE
  EXPENSE_ADDED
  DEPOSIT_CONFIRMED
  BILL_GENERATED
  ANNOUNCEMENT
  SHOPPING_UPDATE
  PAYMENT_NOTICE
  EMERGENCY
  MEETING
  RULE_UPDATE
}

enum NoticeType {
  MEAL
  PAYMENT
  EMERGENCY
  MEETING
  RULE_UPDATE
  GENERAL
}

enum ComplaintCategory {
  MEAL_CORRECTION
  PAYMENT_CORRECTION
  LEAVE_REQUEST
  ROOM_ISSUE
  FOOD_ISSUE
  MAINTENANCE_ISSUE
  OTHER
}

enum ComplaintStatus {
  PENDING
  PROCESSING
  SOLVED
  REJECTED
}

enum ContactRequestSource {
  CONTACT
  SUBSCRIPTION
  UPGRADE
}

enum ContactRequestStatus {
  PENDING
  CONTACTED
  RESOLVED
}

enum AiCommandSourceType {
  TEXT
  VOICE
}

enum AiCommandIntent {
  EXPENSE_CREATE
  UTILITY_CREATE
  DEPOSIT_CREATE
  MEAL_CREATE
  UNKNOWN
  NEEDS_CLARIFICATION
}

enum AiCommandStatus {
  PENDING
  NEEDS_CLARIFICATION
  PROCESSING
  CONFIRMED
  CANCELLED
  FAILED
}
