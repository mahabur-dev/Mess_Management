// ============================================================
// prisma/schema/meal.prisma
// Table: meals
// ============================================================

model Meal {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id        String     @db.Uuid
  name           MealName
  scheduled_date DateTime   @db.Date
  created_by     String     @db.Uuid
  status         MealStatus @default(PENDING)
  note           String?    @db.Text
  is_locked      Boolean    @default(false)
  created_at     DateTime   @default(now()) @db.Timestamptz

  // ─── Relations ─────────────────────────────────────────
  mess        Mess             @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  creator     User             @relation("MealCreator", fields: [created_by], references: [id])
  attendances MealAttendance[]

  @@index([mess_id, scheduled_date])
  @@map("meals")
}
