model MessMembership {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id        String         @db.Uuid
  user_id        String         @db.Uuid
  role           MembershipRole @default(MEMBER)
  joined_at      DateTime       @default(now()) @db.Timestamptz
  left_at        DateTime?      @db.Timestamptz
  is_active      Boolean        @default(true)
  created_by     String?        @db.Uuid
  room_no        String?        @db.VarChar(30)
  seat_no        String?        @db.VarChar(30)
  monthly_rent   Decimal?       @db.Decimal(12, 2)
  deposit_amount Decimal?       @db.Decimal(12, 2)
  due_balance    Decimal        @default(0) @db.Decimal(12, 2)

  mess Mess @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  meal_patterns MealPattern[]

  @@unique([mess_id, user_id])
  @@index([mess_id])
  @@index([user_id])
  @@map("mess_memberships")
}
