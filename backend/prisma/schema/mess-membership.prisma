model MessMembership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id   String         @db.Uuid   // ← ORGANIZER's user.id
  user_id   String         @db.Uuid   // ← MEMBER/MANAGER's user.id
  role      MembershipRole @default(MEMBER)
  joined_at DateTime       @default(now()) @db.Timestamptz
  left_at   DateTime?      @db.Timestamptz
  is_active Boolean        @default(true)

  // Both relations point to User table
  mess User @relation("MessOwner", fields: [mess_id], references: [id], onDelete: Cascade, map: "mess_memberships_mess_id_fkey")
  user User @relation("MessMember", fields: [user_id], references: [id], onDelete: Cascade, map: "mess_memberships_user_id_fkey")

  @@unique([mess_id, user_id])
  @@index([mess_id])
  @@index([user_id])
  @@map("mess_memberships")
}