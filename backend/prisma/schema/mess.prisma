// ============================================================
// prisma/schema/mess.prisma
// Table: messes
// ============================================================

model Mess {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  address     String?  @db.Text
  meal_rate   Decimal  @db.Decimal(10, 2)
  currency    String   @default("BDT") @db.VarChar(10)
  created_by  String   @db.Uuid
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz

  // ─── Relations ─────────────────────────────────────────
  creator        User             @relation("MessCreator", fields: [created_by], references: [id])
  memberships    MessMembership[]
  meals          Meal[]
  expenses       Expense[]
  deposits       Deposit[]
  monthly_bills  MonthlyBill[]
  shopping_lists ShoppingList[]
  notifications  Notification[]
  audit_logs     AuditLog[]

  @@map("messes")
}
