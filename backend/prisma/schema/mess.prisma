// prisma/schema/mess.prisma
// ────────────────────────────────────────────
// Messes table
// ────────────────────────────────────────────

model Mess {
  id             String   @id @default(cuid())
  messName       String
  messLocation   String
  managerId      String
  managerPhone   String
  managerEmail   String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  manager   User         @relation("MessManager", fields: [managerId], references: [id], onDelete: Restrict)
  members   MessMember[]
  bazars    Bazar[]
  deposits  Deposit[]
  meals     Meal[]
  notifications Notification[]

  @@map("messes")
}

// Join table: tracks which users are members of which mess
model MessMember {
  id        String   @id @default(cuid())
  messId    String
  userId    String
  joinedAt  DateTime @default(now())

  mess  Mess @relation(fields: [messId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messId, userId])
  @@map("mess_members")
}
