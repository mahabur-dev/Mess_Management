// ============================================================
// prisma/schema/monthly-bill.prisma
// Table: monthly_bills
// ============================================================

model MonthlyBill {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id       String     @db.Uuid
  member_id     String     @db.Uuid
  month         DateTime   @db.Date
  total_meals   Int        @default(0)
  meal_charge   Decimal    @db.Decimal(12, 2)
  utility_share Decimal    @db.Decimal(12, 2)
  deposit_total Decimal    @db.Decimal(12, 2)
  balance       Decimal    @db.Decimal(12, 2)
  status        BillStatus @default(PENDING)
  generated_at  DateTime   @default(now()) @db.Timestamptz

  // ─── Relations ─────────────────────────────────────────
  mess   Mess @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  member User @relation(fields: [member_id], references: [id])

  @@unique([mess_id, member_id, month])
  @@index([mess_id, month])
  @@map("monthly_bills")
}
