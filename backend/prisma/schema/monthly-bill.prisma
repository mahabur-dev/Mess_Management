// ============================================================
// prisma/schema/monthly-bill.prisma
// Table: monthly_bills
// ============================================================

model MonthlyBill {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id       String     @db.Uuid
  member_id     String     @db.Uuid
  month         DateTime   @db.Date
  total_meals   Decimal    @default(0) @db.Decimal(12, 2)
  meal_charge   Decimal    @db.Decimal(12, 2)
  food_bill      Decimal    @default(0) @db.Decimal(12, 2)
  seat_rent      Decimal    @default(0) @db.Decimal(12, 2)
  electricity_bill Decimal @default(0) @db.Decimal(12, 2)
  gas_bill       Decimal    @default(0) @db.Decimal(12, 2)
  wifi_bill      Decimal    @default(0) @db.Decimal(12, 2)
  cleaner_bill   Decimal    @default(0) @db.Decimal(12, 2)
  extra_cost     Decimal    @default(0) @db.Decimal(12, 2)
  utility_share Decimal    @db.Decimal(12, 2)
  deposit_total Decimal    @db.Decimal(12, 2)
  paid_amount    Decimal    @default(0) @db.Decimal(12, 2)
  final_due      Decimal    @default(0) @db.Decimal(12, 2)
  credit_balance Decimal    @default(0) @db.Decimal(12, 2)
  prev_balance  Decimal    @default(0) @db.Decimal(12, 2)
  balance       Decimal    @db.Decimal(12, 2)
  status        BillStatus @default(PENDING)
  due_date      DateTime?  @db.Date
  generated_at  DateTime   @default(now()) @db.Timestamptz

  // ─── Relations ─────────────────────────────────────────
  mess   Mess @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  member User @relation(fields: [member_id], references: [id])
  payments Payment[]

  @@unique([mess_id, member_id, month])
  @@index([mess_id, month])
  @@map("monthly_bills")
}

model MonthlyBillingState {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id         String                   @db.Uuid
  month           DateTime                 @db.Date
  status          BillingCalculationStatus @default(DIRTY)
  revision        Int                      @default(1)
  attempts        Int                      @default(0)
  requested_at    DateTime                 @default(now()) @db.Timestamptz
  started_at      DateTime?                @db.Timestamptz
  calculated_at   DateTime?                @db.Timestamptz
  next_attempt_at DateTime                 @default(now()) @db.Timestamptz
  last_error      String?                  @db.VarChar(1000)

  mess Mess @relation(fields: [mess_id], references: [id], onDelete: Cascade)

  @@unique([mess_id, month])
  @@index([status, next_attempt_at, requested_at])
  @@index([mess_id, month])
  @@map("monthly_billing_states")
}
