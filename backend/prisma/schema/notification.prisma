// ============================================================
// prisma/schema/notification.prisma
// Table: notifications
// ============================================================

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id    String           @db.Uuid
  sender_id  String?          @db.Uuid
  dedupe_key String?          @unique @db.VarChar(255)
  type       NotificationType
  title      String           @db.VarChar(200)
  body       String           @db.Text
  metadata   Json?            @db.JsonB
  created_at DateTime         @default(now()) @db.Timestamptz

  // ─── Relations ─────────────────────────────────────────
  mess   Mess               @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  sender User?              @relation("NotificationSender", fields: [sender_id], references: [id])
  reads  NotificationRead[]

  @@index([mess_id, created_at(sort: Desc)])
  @@map("notifications")
}
