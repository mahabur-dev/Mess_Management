// prisma/schema/notification.prisma
// ────────────────────────────────────────────
// Notification table
// ────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  messId    String?
  senderId  String?  // The user who sent the notification (if any)
  receiverId String? // the user who should receive it
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  mess   Mess?  @relation(fields: [messId], references: [id], onDelete: Cascade)
  sender User?  @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
