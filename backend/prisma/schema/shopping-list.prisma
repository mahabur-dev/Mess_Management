// ============================================================
// prisma/schema/shopping-list.prisma
// Table: shopping_lists
// ============================================================

model ShoppingList {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id      String             @db.Uuid
  title        String             @db.VarChar(150)
  market_date  DateTime           @db.Date
  total_budget Decimal?           @db.Decimal(12, 2)
  status       ShoppingListStatus @default(OPEN)
  created_by   String             @db.Uuid
  created_at   DateTime           @default(now()) @db.Timestamptz

  // ─── Relations ─────────────────────────────────────────
  mess    Mess           @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  creator User           @relation("ListCreator", fields: [created_by], references: [id])
  items   ShoppingItem[]

  @@index([mess_id, market_date])
  @@map("shopping_lists")
}
