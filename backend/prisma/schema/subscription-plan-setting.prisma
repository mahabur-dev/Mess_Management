// ============================================================
// prisma/schema/subscription-plan-setting.prisma
// Table: subscription_plan_settings
// ============================================================

model SubscriptionPlanSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan        SubscriptionPlan @unique
  label       String   @db.VarChar(100)
  price       Decimal  @db.Decimal(12, 2)
  days        Int
  description String   @db.Text
  currency    String   @default("BDT") @db.VarChar(10)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  @@map("subscription_plan_settings")
}
