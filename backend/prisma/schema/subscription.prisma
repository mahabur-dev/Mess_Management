// ============================================================
// prisma/schema/subscription.prisma
// Table: subscriptions
// ============================================================

enum SubscriptionPlan {
  TRIAL
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

model Subscription {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id    String             @unique @db.Uuid
  plan       SubscriptionPlan   @default(TRIAL)
  status     SubscriptionStatus @default(ACTIVE)
  start_date DateTime           @default(now()) @db.Timestamptz
  end_date   DateTime?          @db.Timestamptz
  cancelled_at DateTime?        @db.Timestamptz
  created_at DateTime           @default(now()) @db.Timestamptz
  updated_at DateTime           @updatedAt @db.Timestamptz

  // ─── Relations ─────────────────────────────────────────
  mess Mess @relation(fields: [mess_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([end_date])
  @@map("subscriptions")
}