// prisma/schema/user.prisma
// ────────────────────────────────────────────
// User table
// ────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         Role      @default(MEMBER)
  profileImage String?
  publicId     String?   // Cloudinary public_id for image deletion
  mobileNumber String?
  city         String?
  state        String?
  country      String?
  postcode     String?
  isActive     Boolean   @default(true)
  isVerified   Boolean   @default(false)
  otp          String?
  otpExpiry    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  managedMess    Mess[]         @relation("MessManager")
  messMembers    MessMember[]
  deposits       Deposit[]
  meals          Meal[]
  bazars         Bazar[]
  sentNotifications  Notification[] @relation("NotificationSender")

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}
