// ============================================================
// prisma/schema/user.prisma
// Table: users
// ============================================================

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String     @db.VarChar(100)
  email         String     @unique @db.VarChar(255)
  phone         String?    @db.VarChar(40)
  nid_number    String?    @unique @db.VarChar(32)
  nid_image_url String?    @db.Text
  location      String?    @db.VarChar(255)
  state         String?    @db.VarChar(100)
  city          String?    @db.VarChar(100)
  zipcode       String?    @db.VarChar(20)
  preferred_locale String? @db.VarChar(5)
  firebase_uid     String? @unique @db.VarChar(128)
  password_hash    String  @db.Text
  avatar_url    String?    @db.Text
  role          GlobalRole @default(MEMBER)
  is_active     Boolean    @default(true)
  is_verified   Boolean    @default(false)
  ai_free_commands_used Int @default(0)
  otp           String?    @db.VarChar(6)
  otp_expiry    DateTime?  @db.Timestamptz
  created_at    DateTime   @default(now()) @db.Timestamptz
  updated_at    DateTime   @updatedAt @db.Timestamptz

  // Relations
  created_messes                Mess[]                         @relation("MessCreator")
  memberships                   MessMembership[]
  created_meals                 Meal[]                         @relation("MealCreator")
  meal_attendances              MealAttendance[]               @relation("AttendanceMember")
  created_meal_patterns         MealPattern[]                  @relation("MealPatternCreator")
  expenses_created              Expense[]                      @relation("ExpenseCreator")
  expenses_purchased            Expense[]                      @relation("ExpensePurchaser")
  expense_shares                ExpenseShare[]                 @relation("ExpenseShareMember")
  deposits_made                 Deposit[]                      @relation("DepositMember")
  deposits_confirmed            Deposit[]                      @relation("DepositConfirmer")
  deposit_ledgers               DepositLedger[]                @relation("DepositLedgerMember")
  monthly_bills                 MonthlyBill[]
  generated_monthly_reports     MonthlyReport[]                 @relation("MonthlyReportGenerator")
  finalized_monthly_reports     MonthlyReport[]                 @relation("MonthlyReportFinalizer")
  monthly_report_deliveries     MonthlyReportDelivery[]
  monthly_bill_close_requests   MonthlyBillCloseRequest[]      @relation("MonthlyBillCloseMember")
  requested_bill_closures       MonthlyBillCloseRequest[]      @relation("MonthlyBillCloseRequester")
  reviewed_bill_closures        MonthlyBillCloseRequest[]      @relation("MonthlyBillCloseReviewer")
  created_lists                 ShoppingList[]                 @relation("ListCreator")
  purchased_items               ShoppingItem[]                 @relation("ItemPurchaser")
  notifications_sent            Notification[]                 @relation("NotificationSender")
  notification_reads            NotificationRead[]
  push_subscriptions            PushNotificationSubscription[]
  fcm_device_tokens             FcmDeviceToken[]
  audit_logs                    AuditLog[]                     @relation("AuditActor")
  mess_requests                 MessRequest[]                  @relation("MessRequestRequester")
  reviewed_requests             MessRequest[]                  @relation("MessRequestReviewer")
  member_join_requests          MemberJoinRequest[]            @relation("MemberJoinRequestRequester")
  reviewed_member_join_requests MemberJoinRequest[]            @relation("MemberJoinRequestReviewer")
  payments_made                 Payment[]                      @relation("PaymentMember")
  payments_created              Payment[]                      @relation("PaymentCreator")
  payments_approved             Payment[]                      @relation("PaymentApprover")
  notices_created               Notice[]                       @relation("NoticeCreator")
  complaints_created            Complaint[]                    @relation("ComplaintCreator")
  complaints_updated            Complaint[]                    @relation("ComplaintStatusUpdater")
  contact_requests_reviewed     ContactRequest[]               @relation("ContactRequestReviewer")
  ai_commands                   AiCommand[]
  personal_transactions         PersonalTransaction[]
  family_members                FamilyMember[]
  personal_budgets              PersonalBudget[]
  auth_otp_challenges           AuthOtpChallenge[]
  bazar_schedule_settings_updated BazarScheduleSetting[]         @relation("BazarSettingUpdater")
  bazar_schedules_created         BazarSchedule[]                @relation("BazarScheduleCreator")
  bazar_duty_slots                BazarDutySlot[]                @relation("BazarSlotMember")
  bazar_duty_slots_assigned       BazarDutySlot[]                @relation("BazarSlotAssigner")
  bazar_swap_requests_sent        BazarSwapRequest[]             @relation("BazarSwapRequester")
  bazar_swap_requests_received    BazarSwapRequest[]             @relation("BazarSwapTarget")
  bazar_release_requests          BazarReleaseRequest[]          @relation("BazarReleaseRequester")
  bazar_release_requests_reviewed BazarReleaseRequest[]          @relation("BazarReleaseReviewer")

  @@map("users")
}
