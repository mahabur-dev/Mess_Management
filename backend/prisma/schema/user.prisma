// ============================================================
// prisma/schema/user.prisma
// Table: users
// ============================================================

model User {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String     @db.VarChar(100)
  email         String     @unique @db.VarChar(255)
  phone         String?    @db.VarChar(40)
  password_hash String     @db.Text
  avatar_url    String?    @db.Text
  role          GlobalRole @default(MEMBER)
  is_active     Boolean    @default(true)
  is_verified   Boolean    @default(false)
  otp           String?    @db.VarChar(6)
  otp_expiry    DateTime?  @db.Timestamptz
  created_at    DateTime   @default(now()) @db.Timestamptz
  updated_at    DateTime   @updatedAt @db.Timestamptz

  // Relations
  created_messes           Mess[]             @relation("MessCreator")
  memberships              MessMembership[]
  created_meals            Meal[]             @relation("MealCreator")
  meal_attendances         MealAttendance[]    @relation("AttendanceMember")
  expenses_created         Expense[]          @relation("ExpenseCreator")
  expenses_purchased       Expense[]          @relation("ExpensePurchaser")
  expense_shares           ExpenseShare[]     @relation("ExpenseShareMember")
  deposits_made            Deposit[]          @relation("DepositMember")
  deposits_confirmed       Deposit[]          @relation("DepositConfirmer")
  deposit_ledgers          DepositLedger[]    @relation("DepositLedgerMember")
  monthly_bills            MonthlyBill[]
  created_lists            ShoppingList[]     @relation("ListCreator")
  purchased_items          ShoppingItem[]     @relation("ItemPurchaser")
  notifications_sent       Notification[]     @relation("NotificationSender")
  notification_reads       NotificationRead[]
  push_subscriptions       PushNotificationSubscription[]
  audit_logs               AuditLog[]         @relation("AuditActor")
  mess_requests            MessRequest[]      @relation("MessRequestRequester")
  reviewed_requests        MessRequest[]      @relation("MessRequestReviewer")
  member_join_requests     MemberJoinRequest[] @relation("MemberJoinRequestRequester")
  reviewed_member_join_requests MemberJoinRequest[] @relation("MemberJoinRequestReviewer")
  payments_made            Payment[]          @relation("PaymentMember")
  payments_created         Payment[]          @relation("PaymentCreator")
  payments_approved        Payment[]          @relation("PaymentApprover")
  notices_created          Notice[]           @relation("NoticeCreator")
  complaints_created       Complaint[]        @relation("ComplaintCreator")
  complaints_updated       Complaint[]        @relation("ComplaintStatusUpdater")
  contact_requests_reviewed ContactRequest[]   @relation("ContactRequestReviewer")

  @@map("users")
}
