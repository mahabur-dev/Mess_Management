NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# Enable only after the matching google-services.json contains OAuth clients.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_NATIVE_PUSH_ENABLED=false
# Subscription pages, navigation and API requests are disabled by default.
NEXT_PUBLIC_SUBSCRIPTION_FEATURE_ENABLED=false
