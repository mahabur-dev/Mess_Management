<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/messzen_brand</item>
        <item name="colorAccent">@color/native_control_neutral</item>
        <item name="android:colorAccent">@color/native_control_neutral</item>
        <item name="colorControlActivated">@color/native_control_neutral</item>
        <item name="android:colorControlActivated">@color/native_control_neutral</item>
        <item name="android:timePickerDialogTheme">@style/AppTheme.TimePickerDialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Default app screens place the system bar over the teal header. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Keep every value in the native time-picker header consistently white,
         including the separator and the inactive AM/PM label. -->
    <style name="AppTheme.TimePickerDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:textColorPrimaryInverse">@android:color/white</item>
        <item name="android:textColorSecondaryInverse">@android:color/white</item>
        <item name="android:colorAccent">@color/native_control_neutral</item>
        <item name="android:colorControlActivated">@color/native_control_neutral</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/messzen_brand</item>
        <item name="windowSplashScreenBackground">@color/messzen_brand</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/messzen_brand</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/messzen_brand</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
