{
  "name": "mess-management-dedicated-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:typography": "node scripts/check-typography.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:copy": "node scripts/check-hardcoded-copy.mjs",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "check:locale-surfaces": "node scripts/check-locale-surfaces.mjs",
    "test:phase8": "node scripts/phase8-unit-tests.cjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:visual:update": "node scripts/visual-qa.mjs --update",
    "qa:android": "npm run build && cap sync android && node scripts/android-smoke.mjs",
    "check:google-auth": "node scripts/check-google-services.mjs",
    "qa:android:strict": "npm run build && cap sync android && node scripts/android-smoke.mjs --strict",
    "qa:verify": "node scripts/release-qa.mjs",
    "qa:release": "node scripts/release-qa.mjs --strict-native",
    "cap:init": "cap init \"Mess Management\" com.mess.management --web-dir=out",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "7.5.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/status-bar": "7.0.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "firebase": "11.10.0",
    "lucide-react": "^0.564.0",
    "next": "15.5.22",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
